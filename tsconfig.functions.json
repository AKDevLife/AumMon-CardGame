{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@aummon/game-engine": ["./packages/game-engine/src/index.ts"],
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"],
      "npm:postgres@3.4.9": ["./node_modules/postgres"]
    }
  },
  "include": ["supabase/functions/**/*.ts"],
  "exclude": ["supabase/functions/_shared/game-engine"]
}
